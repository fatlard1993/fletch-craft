{
	"schemaVersion": 1,
	"id": "fletch_craft",
	"mixins": [
		"fletch_craft.mixins.json"
	],
	"version": "${version}",
	"name": "Fletch Craft",
	"description": "Makes the fletching table functional as a specialized crafting station for arrows, bows, crossbows, and wood processing. Data-driven recipes — customizable via datapacks.",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"homepage": "https://github.com/fatlard1993/fletch-craft",
		"sources": "https://github.com/fatlard1993/fletch-craft",
		"issues": "https://github.com/fatlard1993/fletch-craft/issues"
	},
	"license": "MIT",
	"icon": "assets/fletch_craft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.fletch_craft.FletchCraft"
		]
	},
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.0.0"
	},
	"suggests": {
		"village-quests-justfatlard": "*"
	}
}
